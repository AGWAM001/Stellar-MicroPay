frontend/out/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ─── Backend ─────────────────────────────────────────────────────────────────
backend/.env
backend/logs/

# ─── Rust / Cargo ─────────────────────────────────────────────────────────────
target/
# Cargo.lock is committed on purpose: the contract is a deployable artifact, so
# every build — CI, local, release — must resolve the same dependency graph.
# Leaving it unpinned is what broke the contracts CI job (soroban-sdk's
# transitive deps drifted into versions that no longer compile).

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────────────────────
